# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# GOOGLE WORKSPACE INTEGRATION (Google Sheets & Google Drive)
# ==============================================================================
# The Google Spreadsheet ID containing the 'Locations' and 'Booking Requests' sheets.
GOOGLE_SHEETS_SPREADSHEET_ID="1a2WN_AqaV9WS15h-37FDCyVV_ZpLB1IaBDbvb2VYzeU"

# Sheet worksheet tab names
GOOGLE_SHEETS_LOCATIONS_TAB="Locations"
GOOGLE_SHEETS_BOOKINGS_TAB="Booking Requests"

# Google Apps Script Webhook URL (for automatic row append without Service Account)
GOOGLE_SHEETS_WEBHOOK_URL=""

# Google Service Account Credentials (for backend server-side sheet access)
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# Optional API Key for Google Drive public folder read operations
GOOGLE_DRIVE_API_KEY=""

# Server Environment
NODE_ENV="development"
PORT=3000
